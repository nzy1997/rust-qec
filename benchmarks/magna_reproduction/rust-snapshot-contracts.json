{
  "schema": "rmagna.rust-snapshot-contracts.v1",
  "reference_sha256": "c49203a586f5a451e3183b435793df693dd486857356aed8826df5dc723e5454",
  "upstream_commit": "56847478c840395735146ef1e1ccdc3d8aedc10f",
  "roadmap_key": "R04",
  "issue": 1294,
  "required_target": "rust_snapshot_contracts",
  "claims": "Explicit independent Rust contracts; no automatic Python/private-object parity or architecture exclusions.",
  "consumers": {
    "R09": {
      "issue": 1299,
      "contract": "Use immutable captured source plans,explicit trace cache ownership/budgets and literal fallback policy. Unsupported cyclic metadata and Native-private identities remain visible; reference-network tests still require their own full method witnesses."
    },
    "R11": {
      "issue": 1300,
      "contract": "Use typed BitVector record words,IXZY codebooks and owner-bound compact inputs. Snapshot-count statistics count retained groups,not Native fault-packing avoidance. FeedbackTemplate provides ordered partial-decision incidence; it does not execute a quantum circuit."
    }
  },
  "policies": {
    "source_replacement": "Create a fresh plan session for changed operations,initial state or control declarations. Existing batches keep their captured source. No automatic mutable-IR detection.",
    "callbacks": "Every assignment collects callbacks freshly; no probability-value cache. Opaque callbacks cannot enter the immutable trace cache.",
    "fallback": "LiteralPerAssignment is explicit. Unexpected/resource errors propagate once. No automatic Native preparation or backend retry.",
    "cache": "Optional bounded OriginalTraceCache keys source identity and requested path budget. External Arc remains valid after LRU eviction; no source/callback retention by cache keys.",
    "metadata": "Typed operations/control declarations and owned UTF8 labels only. Arbitrary cyclic/aliased Python graphs are unsupported,not excluded from the original352-method denominator."
  },
