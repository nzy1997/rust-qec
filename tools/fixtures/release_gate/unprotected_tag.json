{
  "$base": "valid.json",
  "rulesets": [
    {
      "id": 77,
      "name": "Wrong tag pattern",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [
        {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
      ],
      "conditions": {
        "ref_name": {"include": ["refs/tags/release-*"], "exclude": []}
      },
      "rules": [{"type": "update"}, {"type": "deletion"}]
    }
  ]
}
